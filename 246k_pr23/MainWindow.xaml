<Window x:Class="_246k_pr23.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_246k_pr23"
        mc:Ignorable="d"
        Title="MainWindow" Height="310" Width="550" Background="MediumSlateBlue">

    <Window.Resources>
        <ControlTemplate x:Key="ErrorTemplate">
            <StackPanel>
                <!-- Сам элемент с красной рамкой -->
                <Border BorderBrush="GreenYellow" BorderThickness="1">
                    <AdornedElementPlaceholder/>
                </Border>
                <!-- Сообщение об ошибке -->
                <TextBlock Foreground="GreenYellow" FontSize="10"
               Text="{Binding [0].ErrorContent}" />
            </StackPanel>
        </ControlTemplate>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="Button" x:Key="ButtonRegistration">
            <Setter Property="IsEnabled" Value="True"/>
            <Style.Triggers>
                <!-- Если есть ошибка хотя бы в одном TextBox -->
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=txtName}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=txtEmail}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=txtAge}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <!-- Если чекбокс не отмечен -->
                <DataTrigger Binding="{Binding IsChecked, ElementName=chkAgree}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Регистрация" Grid.Column="0" Grid.Row="0" FontSize="35" FontWeight="Bold" Grid.ColumnSpan="2" Margin="8"/>

        <TextBlock Text="Имя: " Grid.Column="0" Grid.Row="1" />
        <TextBox x:Name="txtName" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="1" Margin="10"/>

        <TextBlock Text="Email: " Grid.Column="0" Grid.Row="2"/>
        <TextBox x:Name="txtEmail" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="2" Margin="10"/>

        <TextBlock Text="Возраст:" Grid.Column="0" Grid.Row="3"/>
        <TextBox x:Name="txtAge" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="3" Margin="10"/>

        <CheckBox x:Name="chkAgree" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Margin="10" FontSize="12" Foreground="White">Согласен с условиями</CheckBox>

        <Button Content="Зарегистрироваться" Style="{StaticResource ButtonRegistration}" Height="30" Width="450" Click="Reg_Click" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" />

    </Grid>
</Window>
